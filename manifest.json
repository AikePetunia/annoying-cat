{
  "manifest_version": 3,
  "name": "annoying-cat",
  "version": "0.1",
  "description": "When your cat approaches to your desktop and you can't see what's going on...",
  "homepage_url": "https://github.com/AikePetunia/annoying-cat",
  "permissions": ["activeTab", "storage", "tabs"],
  "action": {
    "default_icon": "icons/annoying-cat-32-white.avif",
    "theme_icons": [
      {
        "light": "icons/annoying-cat-32-black.avif",
        "dark": "icons/annoying-cat-32-white.avif",
        "size": 32
      }
    ],
    "default_title": "Annoying-cat !",
    "default_popup": "popup/cat-ui.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.instagr.am/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.reddit.com/*",
        "*://*.redd.it/*"
      ],
      "js": ["content/entry.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*.js", "content/utils/*.js", "icons/annoying-cat-32-*.avif"],
      "matches": ["*://*/*"]
    }
  ],
  "developer": {
    "name": "Aike"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "annoying-cat@aike.tech",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
